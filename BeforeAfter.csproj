<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PredPo</AssemblyName>
    <RootNamespace>PredPo</RootNamespace>
    <ApplicationIcon>before-after.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="before-after.ico" />
  </ItemGroup>
</Project>

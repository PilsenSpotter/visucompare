<Window x:Class="PredPo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Před / Po" Height="790" Width="1240" MinHeight="680" MinWidth="980"
        Icon="before-after.ico"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" PreviewKeyDown="MainWindow_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="34,0" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentLightBrush}" Margin="0,0,13,0">
                        <TextBlock Text="↔" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PŘED / PO" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="Porovnejte změnu jediným tahem" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="FullscreenButton" Style="{StaticResource SecondaryButton}" Content="⛶" FontSize="18" Width="38" Height="36" Padding="4" Margin="0,0,8,0" ToolTip="Celá obrazovka (F11)" Click="Fullscreen_Click" />
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource SecondaryButton}" Content="Tmavý režim" Padding="12,8" Margin="0,0,8,0" Click="ToggleTheme_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Otevřít .bfrafr" Padding="12,8" Margin="0,0,8,0" Click="OpenComparison_Click" />
                    <Button x:Name="SaveComparisonButton" Style="{StaticResource AccentButton}" Content="Uložit .bfrafr" Padding="12,8" Margin="0,0,12,0" IsEnabled="False" Click="SaveComparison_Click" />
                    <Button x:Name="AutoSaveToggleButton" Style="{StaticResource SecondaryButton}" Padding="12,7" Click="ToggleAutoSave_Click" ToolTip="Kliknutím zapnete nebo vypnete automatické ukládání">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AutoSaveDot" Width="7" Height="7" Fill="{DynamicResource StatusDotBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="AutoSaveLabel" Text="Auto ukládání: zapnuto" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="34,25,34,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ControlsColumn" Width="300" />
                <ColumnDefinition x:Name="GapColumn" Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ControlsPanel" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock Text="Vaše porovnání" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Vyberte dvojici obrázků" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12" AllowDrop="True" Drop="BeforeDrop" DragOver="ImageCardDragOver">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource BeforeBadgeBackgroundBrush}" DockPanel.Dock="Left" Margin="0,0,9,0">
                                    <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BeforeBadgeTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PŘED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BeforeLabelBrush}" />
                                    <TextBlock x:Name="BeforeFileName" Text="Zatím nevybráno" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="205" />
                                </StackPanel>
                            </DockPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="Vybrat obrázek" HorizontalAlignment="Stretch" Click="ChooseBefore_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" AllowDrop="True" Drop="AfterDrop" DragOver="ImageCardDragOver">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AfterBadgeBackgroundBrush}" DockPanel.Dock="Left" Margin="0,0,9,0">
                                    <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AfterLabelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AfterLabelBrush}" />
                                    <TextBlock x:Name="AfterFileName" Text="Zatím nevybráno" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="205" />
                                </StackPanel>
                            </DockPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="Vybrat obrázek" HorizontalAlignment="Stretch" Click="ChooseAfter_Click" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,18,0,14">
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Prezentace" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="SlideCounter" Text="0 snímků" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousSlideButton" Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="← Předchozí" Padding="8,8" Click="PreviousSlide_Click" IsEnabled="False" />
                            <Button x:Name="NextSlideButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Další →" Padding="8,8" Click="NextSlide_Click" IsEnabled="False" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource AccentButton}" Content="+ Aktuální" Padding="6,8" ToolTip="Přidat aktuální porovnání jako snímek" Click="AddCurrentSlide_Click" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="+ Ze souborů" Padding="6,8" ToolTip="Přidat vybrané soubory .bfrafr jako snímky" Click="AddComparisonFiles_Click" />
                        </Grid>
                        <Button x:Name="SavePresentationButton" Style="{StaticResource SecondaryButton}" Content="Uložit prezentaci…" HorizontalAlignment="Stretch" Padding="9,8" Click="SavePresentation_Click" IsEnabled="False" />
                        <TextBlock Text="Šipky ← → přepínají snímky. Ulož jako jeden soubor .bfrafr." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" LineHeight="15" Margin="2,8,2,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,15" />
                        <Button x:Name="ClearButton" Style="{StaticResource SecondaryButton}" Content="Vymazat porovnání" HorizontalAlignment="Stretch" Click="Clear_Click" />
                        <TextBlock Text="Obrázky zůstávají uložené v tomto počítači, i když zavřete aplikaci." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" LineHeight="17" Margin="2,13,2,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="PreviewCard" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="PreviewHeading" Grid.Row="0" Margin="2,0,2,15">
                        <StackPanel>
                            <TextBlock Text="Náhled porovnání" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Přetáhněte svislou čáru doleva nebo doprava" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Prohodit" HorizontalAlignment="Right" Padding="12,7" Click="Swap_Click" />
                    </Grid>

                    <Border x:Name="PreviewFrame" Grid.Row="1" CornerRadius="12" Background="{DynamicResource PreviewBackgroundBrush}" ClipToBounds="True" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                        <Grid x:Name="PreviewArea" ClipToBounds="True" Background="{DynamicResource PreviewBackgroundBrush}" Cursor="SizeWE"
                              SizeChanged="PreviewArea_SizeChanged" MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                              MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseLeftButtonUp" MouseLeave="Preview_MouseLeave">
                            <Image x:Name="BeforeImage" Stretch="UniformToFill" Visibility="Collapsed" />
                            <Grid x:Name="AfterClip" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="0" ClipToBounds="True" IsHitTestVisible="False">
                                <Image x:Name="AfterImage" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                            </Grid>
                            <Border x:Name="BeforeTag" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#D91C2633" CornerRadius="7" Padding="10,6" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="PŘED" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="AfterTag" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Background="#D91C2633" CornerRadius="7" Padding="10,6" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="PO" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="Divider" Width="2" Background="White" HorizontalAlignment="Left" VerticalAlignment="Stretch" IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.RenderTransform><TranslateTransform x:Name="DividerTransform" /></Border.RenderTransform>
                                <Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="0.35" /></Border.Effect>
                                <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HandleBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="↔" FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EmptyIconBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="▧" FontSize="25" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tady se zobrazí vaše porovnání" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Vyberte obrázek PŘED a PO v levém panelu" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="PositionControlRow" Grid.Row="2" Margin="4,18,4,0">
                        <TextBlock Text="PŘED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BeforeLabelBrush}" VerticalAlignment="Center" />
                        <Slider x:Name="PositionSlider" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center" Margin="50,0,50,0" IsMoveToPointEnabled="True" ValueChanged="PositionSlider_ValueChanged" />
                        <TextBlock Text="PO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AfterLabelBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Application x:Class="VisuCompare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#FBFCFD" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18212F" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#788394" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8993A0" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E7EAF0" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E9EDF1" />
        <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#F0F3F6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#237A72" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1C6861" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#165750" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#E8F4F2" />
        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#F2F7F6" />
        <SolidColorBrush x:Key="StatusTextBrush" Color="#41675E" />
        <SolidColorBrush x:Key="StatusDotBrush" Color="#3A9A75" />
        <SolidColorBrush x:Key="BeforeBadgeBackgroundBrush" Color="#FFF1E8" />
        <SolidColorBrush x:Key="BeforeBadgeTextBrush" Color="#B96A36" />
        <SolidColorBrush x:Key="BeforeLabelBrush" Color="#9C633D" />
        <SolidColorBrush x:Key="AfterBadgeBackgroundBrush" Color="#E7F4F1" />
        <SolidColorBrush x:Key="AfterLabelBrush" Color="#327D6D" />
        <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#F5F7F9" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#273344" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E3E8EE" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EDF1F4" />
        <SolidColorBrush x:Key="LineBrush" Color="#E5E9EF" />
        <SolidColorBrush x:Key="HandleBorderBrush" Color="#DCE2E8" />
        <SolidColorBrush x:Key="EmptyIconBorderBrush" Color="#E3E8ED" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
